<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for Nova Fig's own document type (SVG, PNG and JPEG are already in
     the system database). Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-novafig">
    <comment>Nova Fig document</comment>
    <icon name="br.com.novafoods.novafig"/>
    <glob pattern="*.novafig"/>
  </mime-type>
</mime-info>
