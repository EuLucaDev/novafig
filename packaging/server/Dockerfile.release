# Servidor de colaboração Nova Foods (collab.agcunae.com) a partir do binário publicado no release
# do Nova Fig: nada é compilado na VPS. O SHA-256 é conferido contra o SHA256SUMS.txt do release.
FROM debian:bookworm-slim
ARG NOVAFIG_VERSION=0.5.1
ARG BASE=https://github.com/EuLucaDev/novafig/releases/download
RUN set -eux; \
    apt-get update; apt-get install -y --no-install-recommends ca-certificates curl; rm -rf /var/lib/apt/lists/*; \
    name="novafig-server-${NOVAFIG_VERSION}-linux-x86_64"; cd /tmp; \
    curl -fsSLO "${BASE}/v${NOVAFIG_VERSION}/${name}.tar.gz"; \
    curl -fsSL "${BASE}/v${NOVAFIG_VERSION}/SHA256SUMS.txt" | grep " ${name}.tar.gz$" | sha256sum -c -; \
    tar -xzf "${name}.tar.gz"; install -m 755 "${name}/novafig-server" /usr/local/bin/novafig-server; rm -rf /tmp/*; \
    useradd --system --home /data --shell /usr/sbin/nologin novafig; mkdir -p /data /etc/novafig-server; chown novafig:novafig /data
COPY server.nova.toml /etc/novafig-server/server.toml
USER novafig
VOLUME /data
EXPOSE 47900
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS http://127.0.0.1:47900/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/novafig-server", "--config", "/etc/novafig-server/server.toml"]
