<?xml version="1.0" encoding="utf-8"?>
<!--
  NovaFig MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build novafig.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc novafig.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\NovaFig by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch NovaFig" box. Installs a Start Menu shortcut, makes
  NovaFig the owner of `.novafig`, and offers it under "Open with" for SVG, PNG and JPEG
  (without taking over the user's default app for them), plus novafig-cli when HasCli=1.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for NovaFig forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="NovaFig"
      Manufacturer="Nova Foods"
      Version="$(var.Version)"
      UpgradeCode="EB12A1AC-22F3-5C84-9564-7F162CFB4091"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NovaFig interface design and prototyping tool" Manufacturer="Nova Foods" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NovaFig is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="NovafigIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NovafigIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://workflowind.agcunae.com/apps/novafig" />
    <Property Id="ARPURLUPDATEINFO" Value="https://workflowind.agcunae.com/apps/novafig" />
    <Property Id="ARPHELPLINK" Value="https://workflowind.agcunae.com/inbox" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NovaFig" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by NovafigApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\NovaFig" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="NovaFig" Level="1">
      <ComponentGroupRef Id="NovafigFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNovafig"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through novafig.en-us.wxl. -->
    <Property Id="NovafigVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="NovaFig $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NovaFig" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NovafigExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchNovafig" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="NovafigFiles" Directory="INSTALLFOLDER">
      <Component Id="NovafigApp" Guid="172A47AA-0DED-5D6C-862F-9B21D14ACBA7">
        <File Id="NovafigExe" Source="$(var.BinDir)\novafig.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NovaFig"
              Description="NovaFig interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NovafigIcon.exe" IconIndex="0" />
        </File>

        <!-- .novafig: NovaFig's own format; NovaFig is its default app. -->
        <ProgId Id="Novafig.Document" Description="NovaFig Document" Icon="NovafigExe" IconIndex="0">
          <Extension Id="novafig" ContentType="application/x-novafig">
            <Verb Id="open" Command="Open" TargetFile="NovafigExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Novafig.Image" Description="Image" Icon="NovafigExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Novafig.Image\shell\open\command" Value="&quot;[#NovafigExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="Novafig.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Novafig.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Novafig.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Novafig.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "novafig"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe" Name="FriendlyAppName" Value="NovaFig" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe\shell\open\command" Value="&quot;[#NovafigExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe\SupportedTypes" Name=".novafig" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\novafig.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novafig.exe" Value="[#NovafigExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\NovaFig" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="NovafigCli">
        <File Id="NovafigCliExe" Source="$(var.BinDir)\novafig-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
      <Component Id="NovaFoodsLegalNotice">
        <File Id="NovaFoodsLegalNoticeFile" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
